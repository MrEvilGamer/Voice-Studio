{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Studio",
  "version": "0.1.0",
  "identifier": "com.aivoicestudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voice Studio",
        "width": 1120,
        "height": 800,
        "minWidth": 840,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0a0c10",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "tracker-runtime/eye-worker/": "tracker-runtime/eye-worker/"
    }
  }
}
